# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Defaults to local MongoDB; automatically activates development in-memory MongoDB fallback if local mongod is not running
MONGODB_URI=mongodb://127.0.0.1:27017/xyz_school
AUTO_FALLBACK_MEMORY_DB=true

# Security
JWT_SECRET=xyz_school_super_secret_jwt_token_key_2026_academic
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
